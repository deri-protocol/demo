# Copy this file to `.env` in the same folder and fill in your real values.

ICHAIN_PROVIDER_URL=https://sepolia-rollup.arbitrum.io/rpc
DCHAIN_PROVIDER_URL=https://testnet-rpc-dchain.deri.io
BUNDLER_RPC_URL=https://testnet-bundler.deri.io/rpc
GRAPHQL_URL=https://testnet-v43dh.deri.io/graphql
ENTRY_POINT_ADDRESS=0x4337084d9e255ff0702461cf8895ce9e3b5ff108
PAYMASTER_ADDRESS=0x660Db157e1FcDBe1CB15aB5445B7D1C9a8717829

ACCOUNT_ADDRESS=0xYOUR_EOA_ADDRESS
ACCOUNT_PRIVATE=0xYOUR_PRIVATE_KEY

# Optional: if unset, the demo generates a local session key in `.session_key.json`.
# SESSION_KEY_PRIVATE=0xYOUR_SESSION_KEY_PRIVATE

# Optional manual pool overrides for debugging only.
# Leave these unset to let the script auto-select the pool from the live symbol listing.
# ZONE_OVERRIDE=main
# GATEWAY_ADDRESS_OVERRIDE=0x49601577be0f0f0a75c38349f38dd85e70accdb7
# GATEWAY_INDEX_OVERRIDE=0

WAIT_TIMEOUT=300
POLL_INTERVAL=2
